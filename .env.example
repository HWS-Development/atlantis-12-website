# Atlantis 12 — environment variables
# Copy to `.env.local` (git-ignored) and fill in real values, or set the same
# variables in the Vercel project's Environment Variables panel.

# Google Maps JavaScript API key, restricted to the production domain.
# Used by the embedded Google Map and live Google reviews.
VITE_GOOGLE_MAPS_API_KEY=

# Atlantis 12-owned GA4 web stream measurement ID (format: G-XXXXXXXXXX).
VITE_GA_MEASUREMENT_ID=

# Formspree endpoint for the contact form.
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/mvzjqwyo
