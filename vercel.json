{
  "redirects": [
    { "source": "/", "has": [{ "type": "query", "key": "lng", "value": "en" }], "destination": "/en", "permanent": true },
    { "source": "/la-maison", "has": [{ "type": "query", "key": "lng", "value": "en" }], "destination": "/en/la-maison", "permanent": true },
    { "source": "/chambres", "has": [{ "type": "query", "key": "lng", "value": "en" }], "destination": "/en/chambres", "permanent": true },
    { "source": "/table-dhotes", "has": [{ "type": "query", "key": "lng", "value": "en" }], "destination": "/en/table-dhotes", "permanent": true },
    { "source": "/experiences", "has": [{ "type": "query", "key": "lng", "value": "en" }], "destination": "/en/experiences", "permanent": true },
    { "source": "/contact", "has": [{ "type": "query", "key": "lng", "value": "en" }], "destination": "/en/contact", "permanent": true },
    { "source": "/maison-dart", "has": [{ "type": "query", "key": "lng", "value": "en" }], "destination": "/en/maison-dart", "permanent": true },
    { "source": "/essaouira", "has": [{ "type": "query", "key": "lng", "value": "en" }], "destination": "/en/essaouira", "permanent": true }
  ],
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/la-maison", "destination": "/la-maison/index.html" },
    { "source": "/chambres", "destination": "/chambres/index.html" },
    { "source": "/table-dhotes", "destination": "/table-dhotes/index.html" },
    { "source": "/experiences", "destination": "/experiences/index.html" },
    { "source": "/contact", "destination": "/contact/index.html" },
    { "source": "/maison-dart", "destination": "/maison-dart/index.html" },
    { "source": "/essaouira", "destination": "/essaouira/index.html" },
    { "source": "/en", "destination": "/en/index.html" },
    { "source": "/en/la-maison", "destination": "/en/la-maison/index.html" },
    { "source": "/en/chambres", "destination": "/en/chambres/index.html" },
    { "source": "/en/table-dhotes", "destination": "/en/table-dhotes/index.html" },
    { "source": "/en/experiences", "destination": "/en/experiences/index.html" },
    { "source": "/en/contact", "destination": "/en/contact/index.html" },
    { "source": "/en/maison-dart", "destination": "/en/maison-dart/index.html" },
    { "source": "/en/essaouira", "destination": "/en/essaouira/index.html" },
    { "source": "/en/:path*", "destination": "/en/index.html" },
    { "source": "/robots.txt", "destination": "/robots.txt" },
    { "source": "/sitemap.xml", "destination": "/sitemap.xml" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
